        "assignments": {
          "assignments": [
            {
              "id": "f3811477-efbf-4d5a-9836-96b3b3caefba",
              "name": "faktenblatt",
              "value": "Workshop: KI im Büroalltag (eintägig)\nTermine: 12. November und 3. Dezember, jeweils 9 bis 16 Uhr\nOrt: online über Zoom\nPreis: 390 Euro pro Person zuzüglich MwSt.\nGruppengröße: höchstens 12 Personen\nStorno: bis 14 Tage vor dem Termin kostenlos, danach 50 % des Preises\nTeilnahmebescheinigung: ja, als PDF nach dem Workshop\nAnmeldung: per E-Mail an anmeldung@workshop.example",
              "type": "string"
            },
            {
              "id": "21eb828c-6cb8-4a4f-9cb9-fe69184c7032",
              "name": "anfrage",
              "value": "Guten Tag, was kostet der Workshop und wann finden die Termine statt?",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2a8fca9d-d681-498a-a109-a71270ad6598",
      "name": "Anfrage und Faktenblatt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Faktenblatt:\n{{ $json.faktenblatt }}\n\nAnfrage:\n{{ $json.anfrage }}",
        "options": {
          "systemMessage": "Du beantwortest Anfragen zum Workshop „KI im Büroalltag“. Antworte auf Deutsch in der Sie-Form, höchstens 120 Wörter.\nNutze nur Angaben aus dem Faktenblatt. Steht etwas nicht darin, schreib, dass wir es klären und uns melden.\nGeht es um eine Frist, nenne zuerst die Regel aus dem Faktenblatt und dann, was sie für den genannten Tag bedeutet. Rechne kein eigenes Datum aus.\nUnterschreibe mit „Ihr Workshop-Team“."
        }
      },
      "id": "c859828b-d62c-4f41-bab9-7dbaaa515282",
      "name": "Schreiber",
      "type": "@n8n/n8n-nodes-langchain.agent",
