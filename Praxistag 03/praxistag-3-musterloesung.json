      ],
      "id": "05b25d2a-3e96-4cf0-85a6-f70d282e7003",
      "name": "Modell Schreiber",
      "credentials": {
        "openAiApi": {
          "id": "2vHahgmuEqMfi9WF",
          "name": "OpenAI Kurs Credential"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Faktenblatt:\n{{ $('Anfrage und Faktenblatt').item.json.faktenblatt }}\n\nAnfrage:\n{{ $('Anfrage und Faktenblatt').item.json.anfrage }}\n\nEntwurf:\n{{ $json.output }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Du prüfst einen Antwortentwurf, bevor er an eine Kundin oder einen Kunden geht.\nRegel 1: Jeder Preis, jedes Datum und jede Frist im Entwurf stimmt mit dem Faktenblatt überein.\nRegel 2: Der Entwurf sagt nichts zu, was nicht im Faktenblatt steht, zum Beispiel einen Rabatt. Erlaubt ist der Hinweis, dass wir eine offene Frage klären und uns melden.\nRegel 3: Der Entwurf beantwortet die Frage aus der Anfrage und widerspricht sich nicht.\nbestanden ist nur true, wenn alle drei Regeln erfüllt sind. grund nennt die verletzte Regel und die Stelle im Entwurf. Ist alles erfüllt, schreib in grund: Alle Regeln erfüllt."
        }
      },
